<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.icesi</groupId>
    <artifactId>studytrack-api</artifactId>
    <!--
        TODO (Fase 2 - Empaquetamiento Inmutable):
        Reemplace "0.0.1-SNAPSHOT" por un esquema de versionado INMUTABLE
        atado al build de Jenkins y al commit de Git, p.ej.:
            <version>${revision}</version>
        y defina <revision> vía -Drevision=... al invocar Maven desde el
        Jenkinsfile (número de build + hash corto del commit).
        Quedan PROHIBIDAS las publicaciones con "SNAPSHOT" o "latest"
        hacia el repositorio de Nexus.
    -->
    <version>${revision}</version>
    <name>studytrack-api</name>
    <description>Backend REST de StudyTrack (Taller Evaluativo 2 - Ingeniería de Software V)</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>studytrack-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        ============================================================
        Publicación Inmutable en Nexus (preconfigurada para el grupo):
        Complete este bloque para que "mvn deploy" (invocado desde el
        Jenkinsfile) publique el .jar en el repositorio "maven-releases"
        de su Nexus local (infra/nexus_config).

        1. Descomente y complete las URLs (host y puerto del servicio
           Nexus levantado en la Fase 3, p.ej. http://localhost:9081/...).
        2. Los <id> deben coincidir EXACTAMENTE con el <server><id> que
           usted registre en su settings.xml de Maven (o en la
           credencial "nexus-credentials" que use el Jenkinsfile).
        3. NUNCA escriba usuario/clave en texto plano en este archivo:
           esas credenciales van en settings.xml (fuera del repo) o
           se inyectan desde Jenkins Credentials.
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <url>http://nexus:8081/repository/maven-releases/</url>
        </repository>
    </distributionManagement>
        ============================================================
    -->
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <url>http://nexus:8081/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

</project>
